# Core application configuration
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codesync"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000

# Use your own Piston-compatible sandbox instance. Do not use the former
# public Piston endpoint: it is whitelist-only and unsuitable for demos.
EXECUTION_API_URL="http://localhost:2000/api/v2/execute"

# Optional: pin known runtime versions offered by your sandbox.
PISTON_CPP_VERSION="*"
PISTON_JS_VERSION="*"
PISTON_PYTHON_VERSION="*"
